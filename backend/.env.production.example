# ============================================================
# Production-окружение Flowers & Sweets.
# Скопировать в .env.production и заполнить:  cp .env.production.example .env.production
# Файл .env.production НЕ коммитить (он в .gitignore).
# ============================================================

# --- Домен ---
# Основной домен API. Caddy получит для него и для panel.<DOMAIN> сертификаты Let's Encrypt.
# Перед запуском должны быть настроены DNS A-записи: <DOMAIN> и panel.<DOMAIN> -> IP VPS.
DOMAIN=flowers.example.tj

# Порты Caddy наружу. В проде -- 80/443 (обязательно для Let's Encrypt).
# Для локальной проверки: HTTP_PORT=8088, HTTPS_PORT=8443 (порт 80 на машине занят tajiflix).
HTTP_PORT=80
HTTPS_PORT=443

# Необязательно: переопределить адреса сайтов Caddy.
# По умолчанию SITE_ADDRESS=$DOMAIN, PANEL_ADDRESS=panel.$DOMAIN.
# Для локальной проверки без HTTPS: SITE_ADDRESS=http://localhost, PANEL_ADDRESS=http://panel.localhost
# SITE_ADDRESS=
# PANEL_ADDRESS=

# --- Django ---
DEBUG=False
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Хосты, которые обслуживает Django. Должны совпадать с DOMAIN.
ALLOWED_HOSTS=flowers.example.tj

# CORS: кто может ходить в API из браузера (панель магазина).
# В settings.py читается ТОЛЬКО при DEBUG=False (при DEBUG=True разрешено всё) -- проверено.
CORS_ALLOWED_ORIGINS=https://panel.flowers.example.tj

# --- БД (внутри docker-сети, хост = имя сервиса db) ---
# Пароль должен совпадать в POSTGRES_PASSWORD и в DATABASE_URL (подставьте его в оба места).
POSTGRES_DB=flowers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgis://postgres:СЮДА_ТОТ_ЖЕ_ПАРОЛЬ@db:5432/flowers

# --- Redis (внутри docker-сети) ---
REDIS_URL=redis://redis:6379/0

# --- SMS (OsonSMS) ---
# osonsms -- реальный шлюз; console -- печать кодов в лог (только для локальной проверки!).
# После первого запуска добавить IP VPS в whitelist в кабинете OsonSMS (иначе ошибка 114).
SMS_BACKEND=osonsms
OSONSMS_API_URL=http://api.osonsms.com/sendsms_v1.php
OSONSMS_LOGIN=
OSONSMS_HASH=
OSONSMS_SENDER=OsonSMS

# --- Платежи ---
# В проде СТРОГО False: stub-провайдер "принимает оплату" без реальных денег.
ALLOW_STUB_PAYMENTS=False

# --- Панель магазина (URL зашиваются в бандл при сборке) ---
# По умолчанию выводятся из DOMAIN -- заполнять не нужно.
# PANEL_API_URL=https://flowers.example.tj/api/v1
# PANEL_WS_URL=wss://flowers.example.tj/ws

# --- OTP (необязательно) ---
# OTP_DAILY_LIMIT=5
